rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ------------------------------------------------------------------
    // Helpers
    // ------------------------------------------------------------------

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && request.auth.token.email == 'daakukwaku7@gmail.com';
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function isVerifiedUser() {
      return signedIn();
    }

    function userDoc(uid) {
      return get(/databases/$(database)/documents/users/$(uid));
    }

    function campaignData(campaignId) {
      return get(/databases/$(database)/documents/campaigns/$(campaignId)).data;
    }

    function isCampaignOwner(campaignId) {
      return signedIn() && campaignData(campaignId).ownerId == request.auth.uid;
    }

    /** Pro = paid period, 7-day trial, or legacy premium still running.
        Mirrors getBillingState() in src/utils/billing.js and campaignHasPro() in api/_lib/billing.js */
    function isProData(c) {
      return c.get('subscription', {}).get('currentPeriodEnd', timestamp.value(0)) > request.time
        || (c.get('packageType', '') == 'trial' && c.get('trialEndsAt', timestamp.value(0)) > request.time)
        || c.get('premiumFeatures', {}).get('campaign-crm', {}).get('expiresAt', timestamp.value(0)) > request.time;
    }

    function isProCampaign(campaignId) {
      return isAdmin() || isProData(campaignData(campaignId));
    }

    function ownsAndPro(campaignId) {
      return isCampaignOwner(campaignId) && isProCampaign(campaignId);
    }

    function sameCampaign() {
      return request.resource.data.campaignId == resource.data.campaignId;
    }

    // ------------------------------------------------------------------
    // Campaign helpers
    // ------------------------------------------------------------------

    function isPublicActiveCampaign() {
      return resource.data.status == 'active'
        && resource.data.get('disabled', false) == false;
    }

    /** Content an owner may change at any time — never billing, status, badges or ranking. */
    function ownerCanEditContent() {
      return signedIn()
        && resource.data.ownerId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'title', 'description', 'bannerImage', 'bannerUrl', 'logoUrl', 'logoImage',
          'galleryImages', 'socialLinks', 'contactEmail', 'contactPhone', 'campaignType',
          'category', 'candidateName', 'party', 'region', 'constituency', 'slogan',
          'priorities', 'electionDate', 'voteTarget', 'registeredVoters', 'themeColor',
          'donation', 'poll', 'sections', 'electionCandidates', 'ownerName', 'updatedAt'
        ]);
    }

    function trialUnused() {
      return !('trialCampaignId' in userDoc(request.auth.uid).data);
    }

    function trialClaimedFor(campaignId) {
      return getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('trialCampaignId', '') == campaignId;
    }

    function validTrialWindow() {
      return request.resource.data.packageType == 'trial'
        && request.resource.data.status == 'active'
        && request.resource.data.trialEndsAt is timestamp
        && request.resource.data.trialEndsAt <= request.time + duration.value(169, 'h')
        && request.resource.data.endDate is timestamp
        && request.resource.data.endDate <= request.time + duration.value(241, 'h');
    }

    /** One free trial per account: the campaign write and users/{uid}.trialCampaignId are set in one batch. */
    function ownerCanStartTrial(campaignId) {
      return signedIn()
        && resource.data.ownerId == request.auth.uid
        && trialUnused()
        && trialClaimedFor(campaignId)
        && validTrialWindow()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'packageType', 'packageName', 'status', 'disabled', 'startDate',
          'trialEndsAt', 'endDate', 'expiresAt', 'updatedAt'
        ]);
    }

    function ownerCanRequestExtension() {
      return isVerifiedUser()
        && resource.data.ownerId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['extensionPending', 'updatedAt']);
    }

    function ownerCanHideCampaign() {
      return isVerifiedUser()
        && resource.data.ownerId == request.auth.uid
        && resource.data.status == 'active'
        && request.resource.data.status == 'disabled'
        && request.resource.data.disabled == true
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'disabled', 'hiddenAt', 'updatedAt']);
    }

    function ownerCanRelaunchCampaign() {
      return isVerifiedUser()
        && resource.data.ownerId == request.auth.uid
        && resource.data.status == 'disabled'
        && request.resource.data.status == 'active'
        && request.resource.data.disabled == false
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'disabled', 'hiddenAt', 'updatedAt']);
    }

    function ownerCanRecordExpiryWarning() {
      return isVerifiedUser()
        && resource.data.ownerId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['expiryWarningSentAt', 'updatedAt']);
    }

    function onlyAnalyticsFieldsChanged() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(['views', 'shares', 'clicks', 'followerCount', 'commentCount', 'updatedAt']);
    }

    function isValidAnalyticsDoc(id) {
      return request.resource.data.campaignId == id
        && request.resource.data.keys().hasAll(['campaignId', 'updatedAt']);
    }

    function isLikeOnly() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes']);
    }

    // ------------------------------------------------------------------
    // Users
    // ------------------------------------------------------------------

    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId)
        && request.resource.data.uid == userId
        && request.resource.data.provider in ['google', 'email', 'otp']
        && request.resource.data.role == (request.auth.token.email == 'daakukwaku7@gmail.com' ? 'admin' : 'user');
      allow update: if isAdmin()
        || (isOwner(userId)
            && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'uid'])
            // trialCampaignId can be set once and never changed or removed
            && (!('trialCampaignId' in resource.data)
                || request.resource.data.get('trialCampaignId', '') == resource.data.trialCampaignId));
      allow delete: if isAdmin();
    }

    match /auth_otp/{docId} {
      allow read, write: if false;
    }

    // ------------------------------------------------------------------
    // Campaigns
    // ------------------------------------------------------------------

    match /campaigns/{campaignId} {
      allow read: if isPublicActiveCampaign()
        || (signedIn() && resource.data.ownerId == request.auth.uid)
        || isAdmin();

      allow create: if isVerifiedUser()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.views == 0
        && request.resource.data.shares == 0
        && request.resource.data.clicks == 0
        && !('subscription' in request.resource.data)
        && !('premiumFeatures' in request.resource.data)
        && request.resource.data.get('verified', false) == false
        && request.resource.data.get('featured', false) == false
        && request.resource.data.get('spotlight', false) == false
        && request.resource.data.get('boostActive', false) == false
        && request.resource.data.get('paymentVerified', false) == false
        && request.resource.data.get('priorityLevel', 0) <= 1
        && (
          (request.resource.data.status == 'payment_pending'
            && request.resource.data.packageType == 'pro')
          || (validTrialWindow()
            && trialUnused()
            && trialClaimedFor(campaignId))
        );

      allow update: if isAdmin()
        || ownerCanEditContent()
        || ownerCanStartTrial(campaignId)
        || ownerCanHideCampaign()
        || ownerCanRelaunchCampaign()
        || ownerCanRecordExpiryWarning()
        || ownerCanRequestExtension()
        || (isPublicActiveCampaign() && onlyAnalyticsFieldsChanged());

      allow delete: if isAdmin()
        || (signedIn() && resource.data.ownerId == request.auth.uid);
    }

    match /analytics/{campaignId} {
      allow read: if true;
      allow create: if isValidAnalyticsDoc(campaignId);
      allow update: if resource.data.campaignId == campaignId
        && request.resource.data.campaignId == campaignId;
    }

    // ------------------------------------------------------------------
    // Billing (written only by the server with Firebase Admin)
    // ------------------------------------------------------------------

    match /billing_transactions/{reference} {
      allow read: if isAdmin()
        || (signedIn() && resource.data.userId == request.auth.uid);
      allow write: if false;
    }

    match /ai_usage/{docId} {
      allow read, write: if false;
    }

    // ------------------------------------------------------------------
    // Public engagement
    // ------------------------------------------------------------------

    match /followers/{followId} {
      allow read: if true;
      allow create: if isVerifiedUser()
        && request.resource.data.userId == request.auth.uid;
      allow delete: if signedIn()
        && resource.data.userId == request.auth.uid;
    }

    match /comments/{commentId} {
      allow read: if true;
      allow create: if isVerifiedUser()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 500;
      allow update: if isAdmin()
        || isLikeOnly()
        || (signedIn() && resource.data.userId == request.auth.uid);
      allow delete: if isAdmin()
        || (signedIn() && resource.data.userId == request.auth.uid);
    }

    match /reports/{reportId} {
      allow create: if isVerifiedUser()
        && request.resource.data.reporterId == request.auth.uid;
      allow read, update: if isAdmin();
    }

    // Legacy manual MoMo payments (screenshot proofs) — kept for existing records
    function ownerPaymentProofUpdate() {
      return signedIn()
        && resource.data.userId == request.auth.uid
        && resource.data.paymentStatus == 'pending'
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.paymentStatus == 'pending_review'
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['screenshotUrl', 'paymentStatus', 'proofSubmittedAt']);
    }

    match /payments/{paymentId} {
      allow read: if isAdmin()
        || (signedIn() && resource.data.userId == request.auth.uid);
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.paymentStatus == 'pending'
        && request.resource.data.campaignId is string
        && request.resource.data.paymentReference is string
        && request.resource.data.amount is number
        && request.resource.data.amount > 0
        && request.resource.data.packageName is string
        && request.resource.data.packageId is string;
      allow update: if isAdmin() || ownerPaymentProofUpdate();
      allow delete: if isAdmin();
    }

    match /notifications/{notificationId} {
      allow read: if signedIn()
        && resource.data.userId == request.auth.uid;
      allow create: if isAdmin()
        || (signedIn() && request.resource.data.userId == request.auth.uid);
      allow update: if signedIn()
        && resource.data.userId == request.auth.uid;
      allow delete: if isAdmin();
    }

    // ------------------------------------------------------------------
    // Campaign workspace data (private to the campaign owner)
    // ------------------------------------------------------------------

    match /supporters/{supporterId} {
      allow read: if isAdmin() || isCampaignOwner(resource.data.campaignId);
      // Public sign-ups, field canvassers and owner imports
      allow create: if request.resource.data.campaignId is string
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 120
        && request.resource.data.phone is string
        && request.resource.data.phone.size() >= 9
        && request.resource.data.phone.size() <= 20;
      allow update: if (isAdmin() || isCampaignOwner(resource.data.campaignId)) && sameCampaign();
      allow delete: if isAdmin() || isCampaignOwner(resource.data.campaignId);
    }

    match /donations/{donationId} {
      allow read: if isAdmin() || isCampaignOwner(resource.data.campaignId);
      allow create: if request.resource.data.campaignId is string
        && request.resource.data.amount is number
        && request.resource.data.amount >= 5
        && request.resource.data.donorName is string
        && request.resource.data.donorPhone is string
        && request.resource.data.paymentStatus == 'pending';
      allow update: if isAdmin()
        || isCampaignOwner(resource.data.campaignId)
        || (request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['screenshotUrl', 'momoTxnId', 'paymentStatus', 'proofSubmittedAt', 'updatedAt'])
            && resource.data.paymentStatus == 'pending'
            && request.resource.data.paymentStatus == 'pending_review');
      allow delete: if isAdmin();
    }

    match /volunteers/{volunteerId} {
      allow read: if isAdmin() || isCampaignOwner(resource.data.campaignId);
      allow create: if request.resource.data.campaignId is string
        && request.resource.data.name is string
        && request.resource.data.phone is string
        && request.resource.data.status == 'pending';
      allow update: if isAdmin() || isCampaignOwner(resource.data.campaignId);
      allow delete: if isAdmin() || isCampaignOwner(resource.data.campaignId);
    }

    match /campaign_events/{eventId} {
      allow read: if true;
      allow create: if isVerifiedUser()
        && ownsAndPro(request.resource.data.campaignId);
      allow update: if isAdmin()
        || isCampaignOwner(resource.data.campaignId)
        || (request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['rsvpCount', 'checkInCount', 'updatedAt']));
      allow delete: if isAdmin() || isCampaignOwner(resource.data.campaignId);
    }

    match /ad_campaigns/{adId} {
      allow read, delete: if isAdmin() || isCampaignOwner(resource.data.campaignId);
      allow create: if ownsAndPro(request.resource.data.campaignId);
      allow update: if (isAdmin() || isCampaignOwner(resource.data.campaignId)) && sameCampaign();
    }

    match /polling_stations/{stationId} {
      allow read, delete: if isAdmin() || isCampaignOwner(resource.data.campaignId);
      allow create: if ownsAndPro(request.resource.data.campaignId);
      allow update: if (isAdmin() || isCampaignOwner(resource.data.campaignId)) && sameCampaign();
    }

    match /broadcasts/{broadcastId} {
      allow read, delete: if isAdmin() || isCampaignOwner(resource.data.campaignId);
      allow create: if ownsAndPro(request.resource.data.campaignId);
      allow update: if false;
    }

    // Private field links: the unguessable document id is the capability.
    match /field_links/{token} {
      allow get: if true;
      allow list: if isAdmin() || isCampaignOwner(resource.data.campaignId);
      allow create: if token.size() >= 20
        && ownsAndPro(request.resource.data.campaignId);
      allow update: if (isAdmin() || isCampaignOwner(resource.data.campaignId)) && sameCampaign();
      allow delete: if isAdmin() || isCampaignOwner(resource.data.campaignId);
    }

    function fieldLink(token) {
      return get(/databases/$(database)/documents/field_links/$(token)).data;
    }

    function validAgentResult() {
      let t = request.resource.data.token;
      return t is string
        && t.size() >= 20
        && exists(/databases/$(database)/documents/field_links/$(t))
        && fieldLink(t).campaignId == request.resource.data.campaignId
        && fieldLink(t).mode == 'results'
        && fieldLink(t).get('active', true) == true
        && fieldLink(t).stationId == request.resource.data.stationId;
    }

    match /election_results/{resultId} {
      allow read, delete: if isAdmin() || isCampaignOwner(resource.data.campaignId);
      allow create: if request.resource.data.campaignId is string
        && request.resource.data.votes is map
        && request.resource.data.votes.size() <= 12
        && (isCampaignOwner(request.resource.data.campaignId) || validAgentResult());
      allow update: if false;
    }

    match /poll_responses/{responseId} {
      allow read, delete: if isAdmin() || isCampaignOwner(resource.data.campaignId);
      allow create: if request.resource.data.campaignId is string
        && request.resource.data.option is string
        && request.resource.data.option.size() > 0
        && request.resource.data.option.size() <= 80
        && request.resource.data.keys().hasOnly(['campaignId', 'pollId', 'option', 'region', 'createdAt']);
      allow update: if false;
    }

    // WebCraft GH — website request submissions (NF project)
    match /websiteRequests/{requestId} {
      allow create: if isValidWebsiteRequest();
      allow read: if isAdmin();
      allow update: if isAdmin() && isWebsiteRequestAdminUpdateOnly();
      allow delete: if false;
    }
  }
}

function isValidWebsiteRequest() {
  let data = request.resource.data;

  return data.receiptId is string
    && data.receiptId.matches('REQ-[0-9]{6}')
    && data.status == 'Pending Review'
    && data.customer.fullName is string
    && data.customer.fullName.size() > 0
    && data.customer.phone is string
    && data.customer.phone.size() > 0
    && data.customer.businessName is string
    && data.customer.businessName.size() > 0
    && data.template.id is string
    && data.template.name is string
    && data.template.price is number
    && data.template.price >= 0
    && data.deployment is bool
    && data.selectedFeatures is list
    && data.selectedUpgrades is list
    && data.totalPrice is number
    && data.totalPrice >= data.template.price
    && data.pricing is map
    && data.pricing.total is number
    && data.pricing.total == data.totalPrice
    && data.pricing.templatePrice == data.template.price
    && data.notes is string;
}

function isWebsiteRequestAdminUpdateOnly() {
  let incoming = request.resource.data;
  let existing = resource.data;

  return incoming.receiptId == existing.receiptId
    && incoming.customer == existing.customer
    && incoming.template == existing.template
    && incoming.selectedFeatures == existing.selectedFeatures
    && incoming.selectedUpgrades == existing.selectedUpgrades
    && incoming.selectedBundle == existing.selectedBundle
    && incoming.pricing == existing.pricing
    && incoming.deployment == existing.deployment
    && incoming.totalPrice == existing.totalPrice
    && incoming.notes == existing.notes
    && incoming.createdAt == existing.createdAt
    && incoming.status is string;
}
