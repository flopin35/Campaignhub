# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx   (Google App Password for campaignhubgh@gmail.com)
# SMTP_USER=campaignhubgh@gmail.com        (optional — defaults to campaignhubgh@gmail.com)
# SMTP_PASS=                               (same as GMAIL_APP_PASSWORD, spaces OK)
# RESEND_API_KEY=re_...                    (optional fallback — must be a valid Resend key)
# OTP_EMAIL_FROM=CampaignHub <campaignhubgh@gmail.com>
# OTP_SECRET=random-long-secret
# OTP_DEV_LOG=true                         (local dev — logs OTP to terminal when email not configured)
#
